Bootstrap: docker
From: amd64/ubuntu:jammy

# Based on the official CellProfiler Dockerfile, updated to jammy:
# https://github.com/CellProfiler/distribution/blob/master/docker/Dockerfile

%environment
    export JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64

%post
# install CellProfiler build dependencies; python 3.9 is not in jammy, so use deadsnakes
    rm -rf /var/lib/apt/lists/*
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y software-properties-common
    add-apt-repository -y ppa:deadsnakes/ppa
    apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
         make gcc build-essential libgtk-3-dev wget git \
         python3.9-dev python3.9-venv openjdk-11-jdk-headless default-libmysqlclient-dev \
         libnotify-dev libsdl2-dev libwebkit2gtk-4.0-dev

# Install CellProfiler 4.2.8 into a venv; the symlink keeps the venv python off PATH
# so it does not shadow the system python3 that xpra uses
    export JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
    python3.9 -m venv /opt/venv
    /opt/venv/bin/pip install --upgrade pip
    /opt/venv/bin/pip install wheel cython "numpy<1.25"
    /opt/venv/bin/pip install https://extras.wxpython.org/wxPython4/extras/linux/gtk3/ubuntu-22.04/wxPython-4.2.1-cp39-cp39-linux_x86_64.whl
    # python-javabridge is sdist-only and needs the numpy/cython installed above at build time
    /opt/venv/bin/pip install --no-build-isolation cellprofiler==4.2.8
    /opt/venv/bin/pip cache purge
    ln -s /opt/venv/bin/cellprofiler /usr/local/bin/cellprofiler

# Install latest Xpra and dependencies
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y wget gnupg2 apt-transport-https \
    netcat uuid-runtime software-properties-common ca-certificates && \
    wget -O "/usr/share/keyrings/xpra.asc" https://xpra.org/xpra.asc && \
    wget -O "/etc/apt/sources.list.d/xpra.sources" https://raw.githubusercontent.com/Xpra-org/xpra/master/packaging/repos/jammy/xpra.sources

    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -yqq \
    xpra \
    xvfb \
    xterm \
    sshfs && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

%test
    /opt/venv/bin/python -c "import wx, bioformats, cellprofiler_core; print('wx', wx.version())"
    /opt/venv/bin/pip show cellprofiler

%runscript
    #!/bin/bash
    # setup secure DISPLAY
    export DISPLAY=:$(shuf -n 1 -i 100-200)
    export XAUTHORITY="${HOME}/.Xauthority"
    xauth add ${DISPLAY} . "$(mcookie)"
    mkdir -p $HOME/.xpra
    chmod 700 $HOME/.xpra
    export XDG_RUNTIME_DIR=$HOME/.xpra
    while PORT=$(shuf -n 1 -i 49152-65535); nc -z 0.0.0.0 $PORT; do continue; done
    export XPRA_PASSWORD=$(uuidgen)
    echo "========================================="
    echo "Password is $XPRA_PASSWORD"
    echo "Launching CellProfiler to display via Xpra on DISPLAY $DISPLAY. Connect via"
    echo "http://$(hostname -i):$PORT/?password=$XPRA_PASSWORD"
    echo "Logging errors to /tmp/xpra.log"
    echo "========================================="
    xpra start \
    --minimal=yes \
    --bind-tcp=0.0.0.0:$PORT,auth=env \
    --websocket-upgrade=yes \
    --socket-dirs=$XDG_RUNTIME_DIR \
    --opengl=yes \
    --html=on \
    --compression-level=1 \
    --start="cellprofiler" \
    --exit-with-windows=yes \
    --daemon=no \
    --clipboard=yes \
    --xvfb="/usr/bin/Xvfb +extension Composite -screen 0 1920x1080x24+32 -nolisten tcp -noreset -auth $XAUTHORITY" \
    $DISPLAY \
    2>/tmp/xpra.log | tee --append /tmp/xpra.log
